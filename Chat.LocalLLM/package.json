  "license": "ISC",
  "description": "",
  "type": "commonjs",
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/swagger-ui-express": "^4.1.8",
    "chokidar-cli": "^3.0.0",
    "esbuild": "^0.27.0",
    "nodemon": "^3.1.11",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.0",
    "express": "^5.1.0",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "^6.6.0",
    "tsyringe": "^4.10.0"
  }
