{
  "name": "chat.localllm",
  "version": "1.0.0",
  "scripts": {
    "tsoa:gen": "tsoa routes && tsoa spec",
    "tsc": "tsc",
    "build": "npm-run-all tsoa:gen tsc",
    "start": "node --env-file=local-node.env dist/server.js",
    "dev": "npm-run-all --parallel watch:src serve",
    "watch:src": "chokidar \"src/**/*\" --initial -c \"npm run build\"",
    "serve": "nodemon --watch ./dist --exec \"node --env-file=local-node.env ./dist/server.js\""
  },
